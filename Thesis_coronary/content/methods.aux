\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces The two association models on a made-up coronary tree, with the centerline inside each artery and a plaque on the wall of the LAD. In the bifurcation model, the angle $\theta $ at the bifurcation point $O$ and the daughter asymmetry from the diameters $D_{\mathrm  {LAD}}$ and $D_{\mathrm  {LCx}}$ are related to one outcome per participant, plaque in the proximal LAD or the proximal LCx (shaded) (left). In the curvature model, the LAD, the LCx and the RCA are divided into proximal, mid and distal segments. The average curvature of each segment is related to the outcome of that segment, and the nine segments of a participant share the random intercept $b_i$ (right).\relax }}{36}{figure.caption.22}\protected@file@percent }
\newlabel{fig:method-models}{{6.5}{36}{The two association models on a made-up coronary tree, with the centerline inside each artery and a plaque on the wall of the LAD. In the bifurcation model, the angle $\theta $ at the bifurcation point $O$ and the daughter asymmetry from the diameters $D_{\mathrm {LAD}}$ and $D_{\mathrm {LCx}}$ are related to one outcome per participant, plaque in the proximal LAD or the proximal LCx (shaded) (left). In the curvature model, the LAD, the LCx and the RCA are divided into proximal, mid and distal segments. The average curvature of each segment is related to the outcome of that segment, and the nine segments of a participant share the random intercept $b_i$ (right).\relax }{figure.caption.22}{}}
\newlabel{fig:method-models@cref}{{[figure][5][6]6.5}{[1][35][]36}}
