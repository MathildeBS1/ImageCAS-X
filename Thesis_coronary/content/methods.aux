\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces Area-equivalent diameter of one cross-section, computed with the thesis code on a made-up lumen surface. The plane perpendicular to the centerline crosses two edges of each mesh triangle it cuts, and the crossing points $p_i$, $p_{i+1}$ form the contour of the cross-section. The area $A$ is the sum of the triangles from the centroid $c$ to each pair of neighbouring contour points, and $D$ is the diameter of the circle with the same area.\relax }}{31}{figure.caption.19}\protected@file@percent }
\newlabel{fig:method-ratio}{{6.2}{31}{Area-equivalent diameter of one cross-section, computed with the thesis code on a made-up lumen surface. The plane perpendicular to the centerline crosses two edges of each mesh triangle it cuts, and the crossing points $p_i$, $p_{i+1}$ form the contour of the cross-section. The area $A$ is the sum of the triangles from the centroid $c$ to each pair of neighbouring contour points, and $D$ is the diameter of the circle with the same area.\relax }{figure.caption.19}{}}
\newlabel{fig:method-ratio@cref}{{[figure][2][6]6.2}{[1][30][]31}}
