@article{schultz2023ess,
  title   = {Coronary computed tomography angiography-based endothelial wall shear stress in
             normal coronary arteries},
  author  = {Schultz, Jussi and van den Hoogen, Inge J. and Kuneman, Jurrien H. and
             de Graaf, Michiel A. and Kamperidis, Vasileios},
  journal = {The International Journal of Cardiovascular Imaging},
  volume  = {39},
  number  = {2},
  pages   = {441--450},
  year    = {2023},
  doi     = {10.1007/s10554-022-02739-0},
  note    = {[VERIFIED] Published full text (10 pp., CC BY) read 2026-09-07; PDF in
             docs_thesis/papers/. Normative CCTA distribution over 349 disease-free vessels (visual
             criterion) from 168 patients, 5223 3 mm segments; 0.4 mm in-plane / 0.625 mm slices,
             close to ImageCAS-X. Cite it as the FORM objective 8 should take -- distribution per
             segment, stratified by vessel, sex and calibre, with feasibility reported -- not as a
             reference range. CAREFUL: boundary conditions are NOT patient-specific (fixed 100 mmHg
             inlet, uniform 1 ml/s outlet for every vessel), so with $\tau \propto Q/R^3$ the
             headline diameter gradient (3.8 vs 1.2 Pa) is largely built in; the authors themselves
             attribute the high distal values to omitting side branches -- "this can result in
             unrealistically high ESS values as seen in our study". CAREFUL: they explicitly did NOT
             compare against invasive imaging, so this is not a validation of CCTA-derived shear
             (use eslami2021ccta / ding2023ccta). The sex effect is real but tiny, 1.7 vs 1.9 Pa,
             and p = 0.044 for maximal ESS -- it licenses stratifying by sex, not interpreting the
             magnitude. Left main excluded and side branches unanalysed, so not a tree.
             See docs_thesis/papers/schultz2023ess.md. Author list truncated at 5}
}

