\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces How curvature is computed (made-up artery, thesis code): $1/R$ of the circle through each point and the points 5\,mm away, the profile along the artery and its average $T$ per segment.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:wk12-curv-method}{{1}{2}{How curvature is computed (made-up artery, thesis code): $1/R$ of the circle through each point and the points 5\,mm away, the profile along the artery and its average $T$ per segment}{figure.1}{}}
\newlabel{fig:wk12-curv-method@cref}{{[figure][1][]1}{[1][2][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Largest difference of 1,661 pairs, from the run before the full-artery rule. The Medis RCA is a 14\,mm fragment that bends back on itself beside the tracer RCA. A curvature value needs a point 5\,mm on each side, so the Medis average rests on about 3\,mm of this bend: 0.35\,mm$^{-1}$ against 0.06\,mm$^{-1}$ for the tracer. The two lines share less than 10\,mm, so the pair fails the same-vessel check, and the full-artery rule now excludes such fragments.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:wk12-curv-worst}{{2}{3}{Largest difference of 1,661 pairs, from the run before the full-artery rule. The Medis RCA is a 14\,mm fragment that bends back on itself beside the tracer RCA. A curvature value needs a point 5\,mm on each side, so the Medis average rests on about 3\,mm of this bend: 0.35\,mm$^{-1}$ against 0.06\,mm$^{-1}$ for the tracer. The two lines share less than 10\,mm, so the pair fails the same-vessel check, and the full-artery rule now excludes such fragments}{figure.2}{}}
\newlabel{fig:wk12-curv-worst@cref}{{[figure][2][]2}{[1][2][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Second-largest difference of 1,191 pairs (top) and closest agreement (bottom): the artery of both trees (tracer solid, Medis dashed; start circle, end square) and the curvature along each with its average. At the top, a full Medis LCx of 43\,mm follows the tracer closely and has the same curvature where both run, but the tracer continues to 79\,mm through tight bends, which raise its average from about 0.04 to 0.11\,mm$^{-1}$.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:wk12-curv}{{3}{4}{Second-largest difference of 1,191 pairs (top) and closest agreement (bottom): the artery of both trees (tracer solid, Medis dashed; start circle, end square) and the curvature along each with its average. At the top, a full Medis LCx of 43\,mm follows the tracer closely and has the same curvature where both run, but the tracer continues to 79\,mm through tight bends, which raise its average from about 0.04 to 0.11\,mm$^{-1}$}{figure.3}{}}
\newlabel{fig:wk12-curv@cref}{{[figure][3][]3}{[1][2][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces How the angle is computed (made-up bifurcation). O is the point where the left main divides into the LAD and the LCx. Points 5 to 10\,mm from O, a line fitted through each set, and the angle $\theta $ between their directions.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:wk12-angle-method}{{4}{5}{How the angle is computed (made-up bifurcation). O is the point where the left main divides into the LAD and the LCx. Points 5 to 10\,mm from O, a line fitted through each set, and the angle $\theta $ between their directions}{figure.4}{}}
\newlabel{fig:wk12-angle-method@cref}{{[figure][4][]4}{[1][5][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Second-largest difference (top) and closest agreement (bottom) of 344 compared participants: LM, LAD and LCx, the points 5 to 10\,mm from O and the fitted lines.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:wk12-angle}{{5}{6}{Second-largest difference (top) and closest agreement (bottom) of 344 compared participants: LM, LAD and LCx, the points 5 to 10\,mm from O and the fitted lines}{figure.5}{}}
\newlabel{fig:wk12-angle@cref}{{[figure][5][]5}{[1][5][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces How the diameters are computed (made-up bifurcation, thesis code): the lumen mesh cut at right angles to the centerline, the area of the cut, the circle with the same area, and the median over the 11 cuts 5 to 10\,mm from O. A daughter has a diameter only when all 11 cuts work; the asymmetry is $|a| = |\ln (D_{\mathrm  {LCx}}/D_{\mathrm  {LAD}})|$.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:wk12-asym-method}{{6}{7}{How the diameters are computed (made-up bifurcation, thesis code): the lumen mesh cut at right angles to the centerline, the area of the cut, the circle with the same area, and the median over the 11 cuts 5 to 10\,mm from O. A daughter has a diameter only when all 11 cuts work; the asymmetry is $|a| = |\ln (D_{\mathrm {LCx}}/D_{\mathrm {LAD}})|$}{figure.6}{}}
\newlabel{fig:wk12-asym-method@cref}{{[figure][6][]6}{[1][6][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Second-largest difference (top) and closest agreement (bottom): the lumen with the cut at each depth (LAD blue, LCx orange) and the diameter of each cut (tracer solid, Medis dashed, thin lines the medians).}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:wk12-asym}{{7}{7}{Second-largest difference (top) and closest agreement (bottom): the lumen with the cut at each depth (LAD blue, LCx orange) and the diameter of each cut (tracer solid, Medis dashed, thin lines the medians)}{figure.7}{}}
\newlabel{fig:wk12-asym@cref}{{[figure][7][]7}{[1][6][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Agreement of the tracer with Medis (tracer minus Medis), same-vessel pairs. Mean: the tracer's mean over the pairs; the Medis mean is about the tracer mean minus the bias. Limits of agreement: bias $\pm $ 1.96 SD of differences, the range that holds the difference between the tracer and Medis for about 95\% of pairs. SD between people: the SD of the tracer feature over the pairs, how much the feature varies from person to person; the error matters when the SD of differences is large next to it. ICC(3,1), consistency. Curvature over the whole artery and over the stretch both lines cover. Curvature in degrees/mm is the turning of the centerline per mm, 1/mm $\times \ 180/\pi $. $^{*}$The diameter means, SDs between people and ICCs are on 267 (LAD) and 55 (LCx) pairs, not the 39 of the agreement columns.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:wk12-findings}{{1}{8}{Agreement of the tracer with Medis (tracer minus Medis), same-vessel pairs. Mean: the tracer's mean over the pairs; the Medis mean is about the tracer mean minus the bias. Limits of agreement: bias $\pm $ 1.96 SD of differences, the range that holds the difference between the tracer and Medis for about 95\% of pairs. SD between people: the SD of the tracer feature over the pairs, how much the feature varies from person to person; the error matters when the SD of differences is large next to it. ICC(3,1), consistency. Curvature over the whole artery and over the stretch both lines cover. Curvature in degrees/mm is the turning of the centerline per mm, 1/mm $\times \ 180/\pi $. $^{*}$The diameter means, SDs between people and ICCs are on 267 (LAD) and 55 (LCx) pairs, not the 39 of the agreement columns}{table.1}{}}
\newlabel{tab:wk12-findings@cref}{{[table][1][]1}{[1][8][]8}}
